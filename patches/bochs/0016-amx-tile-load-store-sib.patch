-  if (i->sibIndex() == BX_NIL_REGISTER) {
-    BX_ERROR(("%s: SIB byte required", i->getIaOpcodeNameShort()));
-    exception(BX_UD_EXCEPTION, 0);
-  }
-
+  // The required SIB byte is enforced by decoder_vex64: here, a missing SIB byte and
